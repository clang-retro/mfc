// atlwintest.rc - the dialogs of atlwintest.
#include <windows.h>

#define IDD_ATLDLG 200
#define IDD_ATLSIMPLE 201
#define IDC_NAME 1001

IDD_ATLDLG DIALOGEX 0, 0, 180, 80
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ATL dialog"
FONT 8, "MS Shell Dlg"
BEGIN
  EDITTEXT IDC_NAME, 10, 10, 160, 14, ES_AUTOHSCROLL
  DEFPUSHBUTTON "OK", IDOK, 40, 50, 50, 14
  PUSHBUTTON "Cancel", IDCANCEL, 100, 50, 50, 14
END

IDD_ATLSIMPLE DIALOGEX 0, 0, 120, 50
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
CAPTION "Simple"
FONT 8, "MS Shell Dlg"
BEGIN
  DEFPUSHBUTTON "OK", IDOK, 10, 20, 40, 14
  PUSHBUTTON "No", IDNO, 60, 20, 40, 14
END
