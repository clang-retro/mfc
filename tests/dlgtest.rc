// dlgtest.rc - resources for dlgtest.
#include <windows.h>
#include <commctrl.h>
#include "dlgtest.h"

IDD_TEST DIALOGEX 0, 0, 300, 200
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "MFC dialog test"
FONT 8, "MS Sans Serif"
BEGIN
  LTEXT "&Name:", -1, 7, 9, 40, 8
  EDITTEXT IDC_NAME, 50, 7, 100, 14, ES_AUTOHSCROLL
  LTEXT "&Age:", -1, 7, 27, 40, 8
  EDITTEXT IDC_AGE, 50, 25, 40, 14, ES_AUTOHSCROLL
  CONTROL "&Subscribed", IDC_CHECK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 45, 80, 10
  CONTROL "Red", IDC_RADIO1, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 7, 60, 40, 10
  CONTROL "Green", IDC_RADIO2, "Button", BS_AUTORADIOBUTTON, 50, 60, 40, 10
  CONTROL "Blue", IDC_RADIO3, "Button", BS_AUTORADIOBUTTON, 93, 60, 40, 10
  COMBOBOX IDC_COMBO, 7, 75, 100, 60, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP | WS_GROUP
  LISTBOX IDC_LIST, 7, 93, 100, 40, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
  CONTROL "", IDC_PROGRESS, "msctls_progress32", WS_BORDER, 7, 140, 100, 10
  CONTROL "", IDC_SLIDER, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 7, 155, 100, 15
  CONTROL "", IDC_LISTCTRL, "SysListView32", LVS_REPORT | WS_BORDER | WS_TABSTOP, 160, 7, 133, 60
  CONTROL "", IDC_TREE, "SysTreeView32", TVS_HASLINES | TVS_HASBUTTONS | TVS_LINESATROOT | WS_BORDER | WS_TABSTOP, 160, 72, 133, 70
  PUSHBUTTON "&Press", IDC_BUTTON, 160, 150, 50, 14
  DEFPUSHBUTTON "OK", IDOK, 186, 179, 50, 14
  PUSHBUTTON "Cancel", IDCANCEL, 243, 179, 50, 14
END

IDD_PAGE1 DIALOGEX 0, 0, 200, 100
STYLE DS_SETFONT | WS_CHILD | WS_CAPTION
CAPTION "First"
FONT 8, "MS Sans Serif"
BEGIN
  LTEXT "Text:", -1, 7, 9, 30, 8
  EDITTEXT IDC_PAGE_EDIT, 40, 7, 100, 14, ES_AUTOHSCROLL
END

IDD_PAGE2 DIALOGEX 0, 0, 200, 100
STYLE DS_SETFONT | WS_CHILD | WS_CAPTION
CAPTION "Second"
FONT 8, "MS Sans Serif"
BEGIN
  CONTROL "Option", IDC_PAGE_CHECK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 7, 80, 10
END

STRINGTABLE
BEGIN
  IDS_HELLO "Hello from the string table"
END
