// mditest.rc - resources for mditest.
#include <windows.h>
#include <afxres.h>
#include "mditest.h"

IDR_MAINFRAME MENU
BEGIN
  POPUP "&File"
  BEGIN
    MENUITEM "&New\tCtrl+N", ID_FILE_NEW
    MENUITEM "&Open...\tCtrl+O", ID_FILE_OPEN
    MENUITEM SEPARATOR
    MENUITEM "E&xit", ID_APP_EXIT
  END
  POPUP "&View"
  BEGIN
    MENUITEM "&Toolbar", ID_VIEW_TOOLBAR
    MENUITEM "&Status Bar", ID_VIEW_STATUS_BAR
  END
END

IDR_TESTTYPE MENU
BEGIN
  POPUP "&File"
  BEGIN
    MENUITEM "&New\tCtrl+N", ID_FILE_NEW
    MENUITEM "&Open...\tCtrl+O", ID_FILE_OPEN
    MENUITEM "&Close", ID_FILE_CLOSE
    MENUITEM "&Save\tCtrl+S", ID_FILE_SAVE
    MENUITEM SEPARATOR
    MENUITEM "E&xit", ID_APP_EXIT
  END
  POPUP "&View"
  BEGIN
    MENUITEM "&Toolbar", ID_VIEW_TOOLBAR
    MENUITEM "&Status Bar", ID_VIEW_STATUS_BAR
  END
  POPUP "&Window"
  BEGIN
    MENUITEM "&New Window", ID_WINDOW_NEW
    MENUITEM "&Cascade", ID_WINDOW_CASCADE
    MENUITEM "&Tile", ID_WINDOW_TILE_HORZ
    MENUITEM "&Arrange Icons", ID_WINDOW_ARRANGE
    MENUITEM "S&plit", ID_WINDOW_SPLIT
  END
END

IDR_MAINFRAME ACCELERATORS
BEGIN
  "N", ID_FILE_NEW, VIRTKEY, CONTROL
  "O", ID_FILE_OPEN, VIRTKEY, CONTROL
  "S", ID_FILE_SAVE, VIRTKEY, CONTROL
END

IDD_FORM DIALOG 0, 0, 120, 80
STYLE WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
  LTEXT "Caption:", -1, 7, 9, 30, 8
  EDITTEXT IDC_FORM_EDIT, 40, 7, 70, 12, ES_AUTOHSCROLL
  PUSHBUTTON "Apply", IDC_FORM_BUTTON, 40, 26, 50, 14
END

// The toolbar: version, image width, image height, count, command IDs.
IDR_MAINFRAME 241
BEGIN
  1, 16, 15, 8,
  ID_FILE_NEW, ID_FILE_OPEN, ID_FILE_SAVE, 0,
  ID_EDIT_CUT, ID_EDIT_COPY, ID_EDIT_PASTE, 0
END
IDR_MAINFRAME BITMAP "toolbar.bmp"

STRINGTABLE
BEGIN
  IDR_MAINFRAME "MdiTest"
  IDR_TESTTYPE "\nShape\nShape\nShape Files (*.shp)\n.shp\nMdiTest.Shape\nShape Document"
  ID_FILE_NEW "Create a new document\nNew"
  ID_FILE_OPEN "Open an existing document\nOpen"
  ID_FILE_SAVE "Save the active document\nSave"
END
