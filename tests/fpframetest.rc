// fpframetest.rc - resources for fpframetest.
#include <windows.h>
#include <afxres.h>
#include "fpframetest.h"

IDR_MAINFRAME MENU
BEGIN
  POPUP "&File"
  BEGIN
    MENUITEM "&New", ID_FILE_NEW
    MENUITEM "E&xit", ID_APP_EXIT
  END
  POPUP "&View"
  BEGIN
    MENUITEM "&Toolbar", ID_VIEW_TOOLBAR
    MENUITEM "&Status Bar", ID_VIEW_STATUS_BAR
  END
  POPUP "&Window"
  BEGIN
    MENUITEM "&Cascade", ID_WINDOW_CASCADE
  END
END

// The toolbar: version, image width, image height, count, command IDs.
IDR_MAINFRAME 241
BEGIN
  1, 16, 15, 8,
  ID_FILE_NEW, ID_FILE_OPEN, ID_FILE_SAVE, 0,
  ID_EDIT_CUT, ID_EDIT_COPY, ID_EDIT_PASTE, 0
END
IDR_MAINFRAME BITMAP "toolbar.bmp"

STRINGTABLE
BEGIN
  IDR_MAINFRAME "fpframetest"
  IDS_CUSTOMIZE "Customize..."
  ID_FILE_NEW "Make a new document\nNew"
  ID_FILE_OPEN "Open a document\nOpen"
  AFX_IDS_IDLEMESSAGE "Ready"
END
