// atlctltest.rc - dialogs that name ActiveX controls by CLSID, as the
// dialog editor writes them, with their saved state in DLGINIT records;
// a composite control's dialog; a property page.
#include <windows.h>
#include "atlctltest.h"

// A DIALOG (not DIALOGEX) template: the windowed control, a licensed
// one, and an ordinary item that stays as it is.
IDD_AXDLG DIALOG 0, 0, 220, 110
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ATL controls"
FONT 8, "MS Shell Dlg"
BEGIN
  LTEXT "Label", IDC_LABEL, 7, 7, 60, 10
  CONTROL "", IDC_CTL, "{6A1F0C2E-3B5D-4E7A-9C11-2F8D5E0B7A34}", WS_TABSTOP, 7, 20, 100, 40
  CONTROL "", IDC_LIC, "{6A1F0C2E-3B5D-4E7A-9C11-2F8D5E0B7A36}", WS_TABSTOP, 113, 20, 100, 40
  DEFPUSHBUTTON "OK", IDOK, 109, 89, 50, 14
  PUSHBUTTON "Cancel", IDCANCEL, 163, 89, 50, 14
END

// DLGINIT (type 240). IDC_CTL: no license key, then the stream: the ATL
// version, _cx 2540, _cy 1270, Sides 7, FillColor (VT_I4) 0x123456 and
// Caption (VT_BSTR) "Hi". IDC_LIC: the key "key", then the version.
IDD_AXDLG 240
BEGIN
  IDC_CTL, 0x0376, 38, 0,
  0x0000, 0x0000,
  0x0300, 0x0000, 0x09EC, 0x0000, 0x04F6, 0x0000, 0x0007, 0x0000,
  0x0003, 0x3456, 0x0012,
  0x0008, 0x0006, 0x0000, 0x0048, 0x0069, 0x0000,
  IDC_LIC, 0x0376, 14, 0,
  0x0003, 0x0000, 0x006B, 0x0065, 0x0079,
  0x0300, 0x0000,
  0
END

// A DIALOGEX template, its control's record an _EX one (with an empty
// data binding section): Sides 11, FillColor 0x667788.
IDD_AXDLGEX DIALOGEX 0, 0, 160, 80
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION
CAPTION "ATL controls (ex)"
FONT 8, "MS Shell Dlg", 400, 0, 1
BEGIN
  CONTROL "", IDC_CTL, "{6A1F0C2E-3B5D-4E7A-9C11-2F8D5E0B7A34}", WS_TABSTOP, 7, 7, 100, 40
  DEFPUSHBUTTON "OK", IDOK, 103, 59, 50, 14
END

IDD_AXDLGEX 240
BEGIN
  IDC_CTL, 0x037A, 50, 0,
  0x0000, 0x0000,
  0x000C, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000,
  0x0300, 0x0000, 0x09EC, 0x0000, 0x04F6, 0x0000, 0x000B, 0x0000,
  0x0003, 0x7788, 0x0066,
  0x0008, 0x0006, 0x0000, 0x0048, 0x0069, 0x0000,
  0
END

// The composite control: a control of its own among ordinary ones.
IDD_COMPOSITE DIALOGEX 0, 0, 150, 60
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
  CONTROL "", IDC_INNER, "{6A1F0C2E-3B5D-4E7A-9C11-2F8D5E0B7A34}", WS_TABSTOP, 5, 5, 80, 40
  PUSHBUTTON "Push", IDOK, 95, 5, 50, 14
END

IDD_PAGE DIALOGEX 0, 0, 120, 40
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
  EDITTEXT IDC_PAGEEDIT, 5, 5, 60, 14
END

STRINGTABLE
BEGIN
  IDS_PAGETITLE "Sides"
END
