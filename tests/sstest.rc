// sstest.rc - resources for sstest: the screen saver's name and its
// configuration dialog.
#include <windows.h>
#include <scrnsave.h>

STRINGTABLE
BEGIN
  IDS_DESCRIPTION "Test Saver"
END

DLG_SCRNSAVECONFIGURE DIALOG 0, 0, 160, 60
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Test Saver Setup"
FONT 8, "MS Shell Dlg"
BEGIN
  DEFPUSHBUTTON "OK", IDOK, 50, 36, 50, 14
END
