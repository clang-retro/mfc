// sditest.rc - resources for sditest.
#include <windows.h>
#include <afxres.h>
#include "sditest.h"

IDR_MAINFRAME MENU
BEGIN
  POPUP "&File"
  BEGIN
    MENUITEM "&New\tCtrl+N", ID_FILE_NEW
    MENUITEM "&Open...\tCtrl+O", ID_FILE_OPEN
    MENUITEM "&Save\tCtrl+S", ID_FILE_SAVE
    MENUITEM "Save &As...", ID_FILE_SAVE_AS
    MENUITEM SEPARATOR
    MENUITEM "&Print...\tCtrl+P", ID_FILE_PRINT
    MENUITEM SEPARATOR
    MENUITEM "E&xit", ID_APP_EXIT
  END
  POPUP "&Edit"
  BEGIN
    MENUITEM "&Undo\tCtrl+Z", ID_EDIT_UNDO
    MENUITEM SEPARATOR
    MENUITEM "Cu&t\tCtrl+X", ID_EDIT_CUT
    MENUITEM "&Copy\tCtrl+C", ID_EDIT_COPY
    MENUITEM "&Paste\tCtrl+V", ID_EDIT_PASTE
    MENUITEM SEPARATOR
    MENUITEM "&Find...", ID_EDIT_FIND
    MENUITEM "Select &All", ID_EDIT_SELECT_ALL
  END
  POPUP "&View"
  BEGIN
    MENUITEM "&Toolbar", ID_VIEW_TOOLBAR
    MENUITEM "&Status Bar", ID_VIEW_STATUS_BAR
  END
  POPUP "&Help"
  BEGIN
    MENUITEM "&About SdiTest...", ID_APP_ABOUT
  END
END

IDR_MAINFRAME ACCELERATORS
BEGIN
  "N", ID_FILE_NEW, VIRTKEY, CONTROL
  "O", ID_FILE_OPEN, VIRTKEY, CONTROL
  "S", ID_FILE_SAVE, VIRTKEY, CONTROL
  "Z", ID_EDIT_UNDO, VIRTKEY, CONTROL
  "X", ID_EDIT_CUT, VIRTKEY, CONTROL
  "C", ID_EDIT_COPY, VIRTKEY, CONTROL
  "V", ID_EDIT_PASTE, VIRTKEY, CONTROL
END

// The toolbar: version, image width, image height, count, command IDs.
IDR_MAINFRAME 241
BEGIN
  1, 16, 15, 8,
  ID_FILE_NEW, ID_FILE_OPEN, ID_FILE_SAVE, 0,
  ID_EDIT_CUT, ID_EDIT_COPY, ID_EDIT_PASTE, 0
END
IDR_MAINFRAME BITMAP "toolbar.bmp"

STRINGTABLE
BEGIN
  IDR_MAINFRAME "SdiTest\n\nSdiTest\nText Files (*.txt)\n.txt\nSdiTest.Document\nSdiTest Document"
  ID_FILE_NEW "Create a new document\nNew"
  ID_FILE_OPEN "Open an existing document\nOpen"
  ID_FILE_SAVE "Save the active document\nSave"
  ID_EDIT_CUT "Cut the selection and put it on the Clipboard\nCut"
  ID_EDIT_COPY "Copy the selection and put it on the Clipboard\nCopy"
  ID_EDIT_PASTE "Insert Clipboard contents\nPaste"
END
