// win16wnd.rc - resources for win16wnd, the window test for 16-bit
// Windows (llvm-rc -win16).
#include <windows.h>
#include "win16wnd.h"

IDD_TEST DIALOG 10, 10, 160, 60
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Test"
FONT 8, "MS Sans Serif"
BEGIN
  EDITTEXT IDC_NAME, 7, 7, 100, 12
  DEFPUSHBUTTON "OK", IDOK, 110, 7, 40, 14
  PUSHBUTTON "Cancel", IDCANCEL, 110, 24, 40, 14
END

STRINGTABLE
BEGIN
  ID_TEST_COMMAND "The test command"
END
